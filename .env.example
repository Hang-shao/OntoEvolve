# 复制为 .env 后按需填写。仓库根目录的 .env 不入库（见 .gitignore）。
# 也可以不建 .env，直接把这些变量导出到环境里。

# ---- 嵌入服务（必需：模块 A/B/C 与漂移检测都要向量）-------------------------
# 兼容 OpenAI /v1/embeddings 协议的任意端点
ONTOEVOLVE_EMBED_API_URL=
ONTOEVOLVE_EMBED_API_KEY=
ONTOEVOLVE_EMBED_MODEL=Qwen3-Embedding-0.6B
ONTOEVOLVE_EMBED_DIM=1024

# 若没有嵌入服务，可改用本地模型（需 requirements-optional.txt 里的 torch/transformers）
# ONTOEVOLVE_LOCAL_EMBED_DIR=/path/to/Qwen3-Embedding-0.6B

# ---- 对话模型（仅 AxiomJudge 消融与 LLM judge 交叉验证用，主实验不需要）------
ONTOEVOLVE_CHAT_API_URL=
ONTOEVOLVE_CHAT_API_KEY=
ONTOEVOLVE_CHAT_MODEL=Qwen3-32B

# ---- OWL-DL 推理机（实验 3 / 一致性检查）------------------------------------
# 留空时自动探测 PATH → JAVA_HOME → 常见 JDK 安装目录
ONTOEVOLVE_JAVA_EXE=
# 留空时用 vendor/ 下的 jar（由 scripts/fetch_hermit_deps.py 下载）
ONTOEVOLVE_HERMIT_JAR=
ONTOEVOLVE_OWLAPI_JAR=
ONTOEVOLVE_GETOPT_JAR=
# hermit（默认，完整 OWL 2 DL）| pellet | none
ONTOEVOLVE_REASONER=hermit
ONTOEVOLVE_REASONER_TIMEOUT_S=120

# ---- 路径 -------------------------------------------------------------------
# 模块 A/B/C 的源码（构建基座的实验工程 exp/src）：未随本仓库发布。留空则相关
# 测试与脚本自动跳过（run_exp_cost.py --full、test_build_ontology.py 等）
ONTOEVOLVE_LEGACY_EXP=
# 轨道 2/3 的真实语料根目录（默认是仓库父目录下的 data/，见 data/README.md）
ONTOEVOLVE_DATA_ROOT=
# 图脚本的输出目录（默认 <repo>/figures）
ONTOEVOLVE_FIG_DIR=
# 导出 OWL 时使用的 IRI 基址
ONTOEVOLVE_IRI_BASE=http://ontoevolve.local/ontology#
